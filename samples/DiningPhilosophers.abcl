// DiningPhilosophers.abcl — the classic dining-philosophers problem in AIPL,
// visualised in the aice-avm graphics window.
//
//   * 5 Philosopher actors + 5 Fork actors (each its own actor).
//   * Each Fork is a mutex with a single waiter slot (a fork is shared by
//     exactly two philosophers, so one waiter is enough).
//   * Deadlock is avoided the classic way: each philosopher picks up its
//     LOWER-numbered fork first (philosopher 4 therefore grabs fork 0 before
//     fork 4 — the asymmetry that breaks the cycle).
//   * A Renderer actor redraws the whole scene every frame from colours the
//     philosophers/forks push to it, so the shared graphics buffer never races.
//
// Colours (see the web page legend): philosopher think=2 blue, hungry=4 yellow,
// eat=3 green; fork free=0 grey, held=1 red.  The VM has no arrays, so the
// Renderer's setp/setf use small if-ladders and the pentagon coordinates are
// hard-coded.

class Main {
  var r = 0;
  var f0 = 0; var f1 = 0; var f2 = 0; var f3 = 0; var f4 = 0;
  var p0 = 0; var p1 = 0; var p2 = 0; var p3 = 0; var p4 = 0;
  method tick() {
    r = new Renderer();
    f0 = new Fork(); f1 = new Fork(); f2 = new Fork(); f3 = new Fork(); f4 = new Fork();
    p0 = new Philosopher(); p1 = new Philosopher(); p2 = new Philosopher();
    p3 = new Philosopher(); p4 = new Philosopher();
    send f0.setup(0, r); send f1.setup(1, r); send f2.setup(2, r);
    send f3.setup(3, r); send f4.setup(4, r);
    // philosopher i uses forks i and (i+1)%5, lower-numbered first:
    send p0.setup(0, f0, f1, r);
    send p1.setup(1, f1, f2, r);
    send p2.setup(2, f2, f3, r);
    send p3.setup(3, f3, f4, r);
    send p4.setup(4, f0, f4, r);   // fork 0 first, then fork 4 (breaks deadlock)
    send r.run();
    send p0.think(); send p1.think(); send p2.think();
    send p3.think(); send p4.think();
  }
}

class Fork {
  var held = 0;
  var waiter = 0;
  var r = 0;
  var idx = 0;
  method setup(i, rend) { idx = i; r = rend; held = 0; waiter = 0; }
  method take(phil) {
    if (held == 0) {
      held = 1;
      send r.setf(idx, 1);          // red = held
      send phil.acquired();
    } else {
      waiter = phil;                // remember the one waiter
    }
  }
  method release() {
    if (waiter == 0) {
      held = 0;
      send r.setf(idx, 0);          // grey = free
    } else {
      send r.setf(idx, 1);          // hand straight to the waiter
      send waiter.acquired();
      waiter = 0;
      held = 1;
    }
  }
}

class Philosopher {
  var idx = 0;
  var ff = 0;                       // first fork (lower-numbered)
  var sf = 0;                       // second fork
  var r = 0;
  var got = 0;
  var thinkt = 0;
  var eatt = 0;
  method setup(i, firstFork, secondFork, rend) {
    idx = i; ff = firstFork; sf = secondFork; r = rend;
    got = 0;
    thinkt = 400 + i * 160;         // staggered so they don't move in lockstep
    eatt = 500;
  }
  method think() {
    send r.setp(idx, 2);            // blue = thinking
    wait(thinkt);
    send r.setp(idx, 4);            // yellow = hungry
    send ff.take(self);
  }
  method acquired() {
    got = got + 1;
    if (got == 1) { send sf.take(self); }
    if (got == 2) {
      send r.setp(idx, 3);          // green = eating
      wait(eatt);
      send ff.release();
      send sf.release();
      got = 0;
      send self.think();
    }
  }
}

class Renderer {
  var p0 = 0; var p1 = 0; var p2 = 0; var p3 = 0; var p4 = 0;
  var f0 = 0; var f1 = 0; var f2 = 0; var f3 = 0; var f4 = 0;
  method setp(i, c) {
    if (i == 0) { p0 = c; } if (i == 1) { p1 = c; } if (i == 2) { p2 = c; }
    if (i == 3) { p3 = c; } if (i == 4) { p4 = c; }
  }
  method setf(i, c) {
    if (i == 0) { f0 = c; } if (i == 1) { f1 = c; } if (i == 2) { f2 = c; }
    if (i == 3) { f3 = c; } if (i == 4) { f4 = c; }
  }
  method run() {
    p0 = 2; p1 = 2; p2 = 2; p3 = 2; p4 = 2;
    f0 = 0; f1 = 0; f2 = 0; f3 = 0; f4 = 0;
    send self.frame();
  }
  method frame() {
    cls();
    // philosophers as plus-signs at the pentagon vertices, colour = state
    line(232, 70, 248, 70, p0);   line(240, 62, 240, 78, p0);
    line(356, 160, 372, 160, p1); line(364, 152, 364, 168, p1);
    line(308, 305, 324, 305, p2); line(316, 297, 316, 313, p2);
    line(156, 305, 172, 305, p3); line(164, 297, 164, 313, p3);
    line(108, 160, 124, 160, p4); line(116, 152, 116, 168, p4);
    // forks as short diagonal segments at the midpoints, colour = held/free
    line(296, 109, 308, 121, f0);
    line(334, 226, 346, 238, f1);
    line(234, 299, 246, 311, f2);
    line(134, 226, 146, 238, f3);
    line(172, 109, 184, 121, f4);
    wait(40);
    send self.frame();
  }
}
